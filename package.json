{
  "name": "skowt-monorepo",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "elysia": "^1.4.18",
      "@trpc/server": "^11.5.0",
      "better-auth": "^1.6.11",
      "dotenv": "^17.2.2",
      "zod": "^4.1.11",
      "typescript": "^5.8.2",
      "tsdown": "^0.15.5",
      "@trpc/client": "^11.5.0"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "bun dev:infra && bun dev:wait && bun dev:setup && turbo dev --filter=web --filter=server; bun dev:infra:stop",
    "dev:all": "bun dev:infra && bun dev:wait && bun dev:setup && turbo dev; bun dev:infra:stop",
    "dev:noinf": "turbo dev --filter=web --filter=server",
    "dev:infra": "docker rm -f $(docker ps -aq --filter name=skowt-) 2>/dev/null; docker compose -f docker-compose.dev.yml up -d --force-recreate",
    "dev:infra:stop": "docker compose -f docker-compose.dev.yml down",
    "dev:wait": "bun scripts/wait-for-services.mts",
    "dev:setup": "bun db:push && bun db:fts && bun db:seed",
    "build": "turbo build",
    "check-types": "turbo check-types",
    "lint": "oxlint --deny-warnings",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "turbo test",
    "publish": "bash scripts/publish-public.sh",
    "test:watch": "turbo -F @skowt-monorepo/api test:watch",
    "dev:web": "turbo -F web dev",
    "dev:server": "turbo -F server dev",
    "dev:prod": "turbo dev:prod --filter=web --filter=server",
    "db:push": "turbo -F @skowt-monorepo/db db:push",
    "db:seed": "turbo -F @skowt-monorepo/db db:seed",
    "db:studio": "turbo -F @skowt-monorepo/db db:studio",
    "db:generate": "turbo -F @skowt-monorepo/db db:generate",
    "db:migrate": "turbo -F @skowt-monorepo/db db:migrate",
    "db:fts": "turbo -F @skowt-monorepo/db db:fts"
  },
  "dependencies": {
    "dotenv": "^17.2.2",
    "motion": "^12.23.24",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/bun": "^1.2.6",
    "oxfmt": "^0.56.0",
    "oxlint": "^1.71.0",
    "tsdown": "^0.15.5",
    "turbo": "^2.10.0"
  },
  "overrides": {
    "@sinclair/typebox": "^0.34.41",
    "@types/react": "~19.1.10",
    "@types/react-dom": "^19.0.4",
    "defu": "^6.1.7",
    "jose": "^6.1.3",
    "kysely": "^0.28.17",
    "postcss": "^8.5.14",
    "srvx": "^0.11.15",
    "ws": "^8.20.1"
  },
  "packageManager": "bun@1.3.10"
}
