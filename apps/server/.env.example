NODE_ENV=development

# Database
DATABASE_URL=http://localhost:8082
DATABASE_AUTH_TOKEN=

# Auth
BETTER_AUTH_SECRET=dev-secret-change-me-in-production
BETTER_AUTH_URL=http://localhost:13387

# CORS
CORS_ORIGIN=http://localhost:1337

# Discord OAuth — optional in dev: leave both empty to run without Discord
# (sign-in disabled, the server-membership gate on downloads/bookmarks defaults
# open). To enable, create an app at https://discord.com/developers/applications
# and add http://localhost:13387/api/auth/callback/discord as a redirect URI.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Discord bot interactions endpoint (optional; absent = bot routes answer 503)
DISCORD_BOT_PUBLIC_KEY=

# Discord bot application ID (only needed to run scripts/register-discord-commands.ts)
DISCORD_BOT_APPLICATION_ID=

# Discord lookup worker (optional; falls back to the hosted antifield/discord-lookup deployment)
DISCORD_LOOKUP_URL=

# Redis
REDIS_URL=redis://localhost:6383

# S3 Storage (LocalStack in dev)
S3_ACCESS_KEY_ID=localstack
S3_SECRET_ACCESS_KEY=localstack
S3_ENDPOINT=http://localhost:9004
S3_BUCKET=skowt-assets
S3_CDN_URL=
